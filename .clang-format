# yaml-language-server: $schema=https://json.schemastore.org/clang-format-21.x.json
---
# Start from the LLVM coding style and override only the options that
# differ from the default.
BasedOnStyle: LLVM

# Use 4-space indentation and wrap long lines at 120 columns.
IndentWidth: 4
ColumnLimit: 120

# Target the latest supported C++ standard when formatting.
Standard: Latest

# Keep #include directives grouped and sorted: the main header first, then
# project headers, then Qt, then the standard library. Case-sensitive so that
# '^<Q' does not match <queue>.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"'
    Priority: 1
  - Regex: '^<Q'
    Priority: 2
    CaseSensitive: true
  - Regex: '^<'
    Priority: 3

# Use a custom brace style:
#   - Classes, structs and functions open on a new line.
#   - Control statements (if, for, while, etc.) retain the LLVM style.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterStruct: true
  AfterFunction: true
  SplitEmptyFunction: false

# Keep simple inline member functions on a single line.
AllowShortFunctionsOnASingleLine: Inline

# When arguments do not fit, break after the opening bracket, indent them one
# level and put the closing bracket on its own line.
AlignAfterOpenBracket: BlockIndent

# Qt style constructor initializers: one per line, comma first.
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: Never

# Qt Test macros that take a block, like a for loop.
ForEachMacros: [QBENCHMARK, QBENCHMARK_ONCE]

# Align access specifiers (public:, private:, protected:) with the class
# declaration instead of the member declarations.
AccessModifierOffset: -4
